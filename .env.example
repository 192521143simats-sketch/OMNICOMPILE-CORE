HOST=0.0.0.0
PORT=4100
PUBLIC_BASE_URL=http://localhost:5173
COORDINATOR_PUBLIC_URL=http://localhost:4100
# Production origins must be explicit HTTPS origins, comma-separated.
ALLOWED_ORIGINS=
# Trust forwarded headers only from explicitly configured proxy IPs/CIDRs.
TRUSTED_PROXIES=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-development-password
# Production: replace ADMIN_PASSWORD with an Argon2id ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD_HASH=
SESSION_TTL_HOURS=12
RESET_TTL_MINUTES=20
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=omnicompile
DB_USER=root
# Set both passwords to the same local value. Never use local root credentials
# for production. Set the approved local password in the ignored .env file.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
HEARTBEAT_STALE_MS=15000
HEARTBEAT_OFFLINE_MS=30000
TASK_TIMEOUT_MS=30000
# Docker-contained program execution after compilation. Never falls back to host execution.
OMNICOMPILE_EXECUTION_MODE=docker
OMNICOMPILE_SANDBOX_IMAGE=oa-omnicompile-execution:local
# Optional external providers. Enabling live sends requires explicit operator approval.
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
POSTHOG_ENABLED=false
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
INTEGRATION_TIMEOUT_MS=1500


# Docker language services
# Compose supplies OMNICOMPILE_C_COMPILER_URL, OMNICOMPILE_PYTHON_COMPILER_URL,
# OMNICOMPILE_JAVA_COMPILER_URL and OMNICOMPILE_COMPILER_TOKEN_FILE internally.
# Scoped worker credentials and service tokens are created in ignored .runtime.
# For initial provisioning with hash-only admin configuration, set
# OMNICOMPILE_PROVISION_ADMIN_PASSWORD in the invoking process.
# Linux language images require Landlock; sandbox initialization fails closed.
