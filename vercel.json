{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/Build-Vercel-Frontend.mjs",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "/api(?:/(.*))?",
      "dest": "https://59d2-2402-3a80-40e-2b79-8109-fb4a-a308-1805.ngrok-free.app/api/$1",
      "headers": {
        "Cache-Control": "private, no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "ngrok-skip-browser-warning"
          },
          "args": "1"
        }
      ]
    },
    {
      "src": "/ws(?:/(.*))?",
      "dest": "https://59d2-2402-3a80-40e-2b79-8109-fb4a-a308-1805.ngrok-free.app/ws/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?:login|signup|forgot-password|reset-password|admin|dashboard|worker|web-worker|browser-worker|windows-worker|android-worker|settings|compute)/?",
      "dest": "/index.html"
    },
    {
      "src": "/(?:join|join-network-[A-Za-z]+)/[^/]+(?:/(?:web|windows|android))?/?",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html",
      "status": 404
    }
  ]
}
