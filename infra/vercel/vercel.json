{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace @omnicompile/web",
  "outputDirectory": "apps/web/dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(?:login|signup|forgot-password|reset-password|dashboard|admin|worker|compute|settings)/?", "dest": "/index.html" },
    { "src": "/join/[^/]+/?", "dest": "/index.html" }
  ]
}
